FROM rust:1.98.1-bookworm@sha256:9a73a5088750b4c95158ab26629c854c3d6fc4b173cb7bc8079ad252d8ed7bfa AS builder
WORKDIR /src
COPY Cargo.toml Cargo.lock rust-toolchain.toml ./
COPY crates ./crates
COPY services ./services
RUN cargo build --locked --release -p lastro-api

FROM debian:bookworm-20260918-slim@sha256:3783cc01769c7b2b1b83a5c5ad96c815348e28ed7da68e2e3687004faa906251
COPY --from=builder /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
COPY --from=builder /src/target/release/lastro-api /usr/local/bin/lastro-api
COPY services/api/migrations /app/migrations
# Never run as root: key files in /run/secrets/lastro are owned by this uid (mode 0400).
RUN useradd --system --uid 10001 --no-create-home --shell /usr/sbin/nologin lastro
USER 10001:10001
WORKDIR /app
EXPOSE 8080
ENTRYPOINT ["lastro-api"]
