# Copy this file to .env.production on the VM and chmod 600 it.
# Never commit the real file.

# Automated EC2 deployment: images published by GitHub Actions.
# LASTRO_IMAGE_TAG is managed by scripts/deploy_production.sh; do not edit it by hand.
LASTRO_REGISTRY=ghcr.io/your-github-user-lowercase

SITE_DOMAIN=example.com
API_DOMAIN=api.example.com
# Origins of VITE_SOLANA_RPC_URL (https and its wss twin), allowed by the site's CSP connect-src.
CSP_RPC_ORIGINS=https://api.devnet.solana.com wss://api.devnet.solana.com

POSTGRES_USER=lastro
POSTGRES_DB=lastro
POSTGRES_PASSWORD=generate-a-long-url-safe-random-password

LASTRO_SOLANA_RPC_URL=https://api.devnet.solana.com
LASTRO_PROGRAM_ID=
LASTRO_DEPLOYMENT_ID_HEX=
LASTRO_STATION_PUBKEY_HEX=
LASTRO_AGENT_TOKEN=generate-at-least-32-random-characters
LASTRO_OPERATOR_TOKEN=generate-a-separate-at-least-32-character-operator-token
# Optional priority fee (micro-lamports per compute unit, 1..1000000). Empty = no fee.
LASTRO_PRIORITY_FEE_MICRO_LAMPORTS=
# Comma-separated browser origins allowed to call the API (no trailing slash).
LASTRO_CORS_ALLOWED_ORIGINS=https://example.com
RUST_LOG=info,lastro_api=info

# Fee sponsor (SPEC v2.1 S1): Solana keypair JSON in /opt/lastro/secrets (owner 10001, chmod 400).
# Must not be the deployment authority. Empty keeps every wallet self-paid.
LASTRO_SPONSOR_KEYPAIR_PATH=
# LASTRO_SPONSOR_KEYPAIR_PATH=/run/secrets/lastro/sponsor-keypair.json
LASTRO_SPONSOR_MAX_LAMPORTS_PER_TX=
LASTRO_SPONSOR_DAILY_LAMPORTS_PER_SIGNER=
LASTRO_SPONSOR_DAILY_LAMPORTS_TOTAL=
# Backups: age public key (the identity stays offline) and optional off-host copy.
LASTRO_BACKUP_AGE_RECIPIENT=
LASTRO_BACKUP_S3_URI=

# Organization key vault (S2): file holding 64 lowercase hex chars (32 random bytes), owner 10001, chmod 400.
# Keep an offline copy: without it every sealed organization key is lost. Empty disables it.
LASTRO_ORG_KEY_ENCRYPTION_KEY_FILE=
# LASTRO_ORG_KEY_ENCRYPTION_KEY_FILE=/run/secrets/lastro/org-master-key.hex

VITE_API_BASE_URL=https://api.example.com
VITE_SOLANA_RPC_URL=https://api.devnet.solana.com
VITE_SOLANA_CHAIN=solana:devnet
VITE_LASTRO_PROGRAM_ID=
VITE_LASTRO_DEPLOYMENT_ID_HEX=
VITE_LASTRO_AUTHORITY=
# Public key of LASTRO_SPONSOR_KEYPAIR_PATH; empty when sponsorship is off.
VITE_LASTRO_SPONSOR=
