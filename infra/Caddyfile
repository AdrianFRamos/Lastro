# Serves the built SPA inside the web container. Security headers are set at the public edge
# (Caddyfile.production); here hashed assets are cached forever and index.html never is.
:80 {
  root * /srv
  encode zstd gzip

  # Path-matched handle runs before the catch-all; `route` keeps the inner order explicit.
  handle /assets/* {
    route {
      # A missing hashed asset is a plain, uncached 404, never index.html served as
      # JavaScript after a deploy (respond ends the route before the cache header is added).
      @missing not file
      respond @missing 404
      header Cache-Control "public, max-age=31536000, immutable"
      file_server
    }
  }

  handle {
    header Cache-Control "no-cache"
    try_files {path} /index.html
    file_server
  }
}
