# API
LASTRO_API_BIND=0.0.0.0:8080
LASTRO_DATABASE_URL=postgres://lastro:lastro@127.0.0.1:5432/lastro
LASTRO_SOLANA_RPC_URL=https://api.devnet.solana.com
LASTRO_PROGRAM_ID=
LASTRO_DEPLOYMENT_ID_HEX=
LASTRO_STATION_PUBKEY_HEX=
LASTRO_AGENT_TOKEN=replace-with-at-least-32-random-characters
RUST_LOG=info,lastro_api=debug,lastro_agent=debug

# Agent (host process; normally not containerized because it owns the Station serial device)
LASTRO_AGENT_API_URL=http://127.0.0.1:8080
LASTRO_AGENT_SERIAL_PORT=
LASTRO_AGENT_SERIAL_BAUD=115200
LASTRO_AGENT_SQLITE_URL=sqlite://agent.db?mode=rwc
LASTRO_AGENT_POLL_INTERVAL_MS=500
LASTRO_AGENT_REQUEST_TIMEOUT_MS=5000

# Web
VITE_API_BASE_URL=http://127.0.0.1:8080
VITE_SOLANA_RPC_URL=https://api.devnet.solana.com
VITE_SOLANA_CHAIN=solana:devnet
VITE_LASTRO_PROGRAM_ID=

# Physical Station validation (operator-controlled; never enable in ordinary CI)
LASTRO_HARDWARE_TEST=0
LASTRO_HARDWARE_INTERACTIVE=0
LASTRO_HARDWARE_TAG_A_RFID_HEX=
LASTRO_HARDWARE_TAG_B_RFID_HEX=
LASTRO_HARDWARE_CUSTODIAN_HEX=
LASTRO_HARDWARE_REBOOT_COMMAND=
LASTRO_HARDWARE_REBOOT_WAIT_SECONDS=8
LASTRO_HARDWARE_CAPTURE_TIMEOUT_SECONDS=20
LASTRO_HARDWARE_ARTIFACT_DIR=
LASTRO_HARDWARE_TAG_A_RAW_FRAME_FILE=
LASTRO_HARDWARE_TAG_B_RAW_FRAME_FILE=

# Optional H1 eFuse inspection. Generate the JSON with espefuse summary --format json.
LASTRO_EFUSE_TEST=0
LASTRO_EFUSE_SUMMARY_JSON=
LASTRO_EFUSE_BLOCK_FIELD=
LASTRO_EFUSE_PURPOSE_FIELD=
